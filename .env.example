# Example environment for the history-video pipeline.
# Copy to .env and fill in your keys. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env

# Gemini API keys (free tier, Google AI Studio) — comma-separated, the
# verify-visuals gate rotates past dead/quota keys automatically.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEYS=key_one,key_two

# Mapbox public token — used by scripts/fetch_map.py for the map-callout
# overlay (satellite + pin). ~1-3 requests per video, free tier is plenty.
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
